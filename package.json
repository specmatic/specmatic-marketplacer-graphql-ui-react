{
  "name": "specmatic-order-graphql-ui-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^4.0.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.12.2",
    "cross-env": "^10.1.0",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "graphql-http": "^1.22.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scripts": "^5.0.1",
    "react-toastify": "^11.0.5",
    "web-vitals": "^5.1.0"
  },
  "specmatic": {
    "logLevel": "debug"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --coverage --detectOpenHandles --forceExit --transformIgnorePatterns \"node_modules/(?!axios)/\"",
    "eject": "react-scripts eject",
    "graphiql": "node graphiql-server.js",
    "specmatic:stub": "node -e \"require('child_process').execSync('docker run --rm -v ' + process.cwd() + ':/usr/src/app -p 8080:8080 specmatic/specmatic-graphql virtualize --port 8080 --examples=test_data', {stdio: 'inherit'})\"",
    "test-ci": "cross-env SPECMATIC_LOG_LEVEL=debug DEBUG=specmatic-order-graphql-ui-react:* npm run test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.15",
    "testcontainers": "^11.7.1"
  }
}
